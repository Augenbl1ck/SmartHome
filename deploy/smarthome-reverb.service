[Unit]
Description=SmartHome Reverb WebSocket Server
After=network.target smarthome-backend.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SmartHome/backend
ExecStart=/usr/bin/php8.4 artisan reverb:start --port=6001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
