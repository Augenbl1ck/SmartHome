[Unit]
Description=SmartHome Laravel Backend API
After=network.target php8.4-fpm.service nginx.service
Wants=php8.4-fpm.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SmartHome/backend
ExecStart=/bin/bash /home/pi/SmartHome/deploy/run-backend.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
