APP_NAME=SmartHome
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Berlin
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Datenbank ----------------------------------------------------------------
# Lokal (SQLite, kein Server noetig):
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/smarthome.sqlite

# Produktion / Raspberry Pi (PostgreSQL):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=smarthome
# DB_USERNAME=smarthome
# DB_PASSWORD=secret

# --- MQTT ---------------------------------------------------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# --- WebSocket (Laravel Reverb) -----------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Session / Cache / Queue --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# --- Mail (optional) ----------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="smarthome@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Spotify (Dashboard-Widget + Web Playback auf dem Panel) -------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI="${APP_URL}/api/v1/spotify/callback"
# Frontend-URL für OAuth-Redirect nach Callback
FRONTEND_URL=http://localhost:3000
