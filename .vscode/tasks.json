      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "SmartHome: Ohne Sim",
