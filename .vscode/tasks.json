{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mosquitto",
      "type": "shell",
      "command": "Get-Process mosquitto -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep 1; & 'C:\\Program Files\\mosquitto\\mosquitto.exe' -c '${workspaceFolder}\\.vscode\\mqtt.conf' -v",
      "options": {
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "smarthome",
        "reveal": "always"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "C:\\php82\\php.exe artisan serve",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "smarthome",
        "reveal": "always"
      },
      "isBackground": true,
      "problemMatcher": []
    },
